"""Agent LangGraph de BFPME Recruit.

Graphe : analyze -> (retrieve | platform | generate)
         retrieve -> (rewrite -> retrieve) | generate
Les dépendances (llm, recherche, API Spring) sont injectées : testable sans réseau.
"""
import json
import re
from typing import Callable, Optional, TypedDict

from langgraph.graph import StateGraph, END

MAX_ATTEMPTS = 2   # nombre max de recherches par question
MIN_CHUNKS = 2     # en dessous, on reformule la requête


class AgentState(TypedDict, total=False):
    question: str
    intent: str            # search_candidates | list_offers | chitchat
    search_query: str
    offer_id: Optional[str]
    chunks: list
    platform_info: str
    attempts: int
    answer: str
    sources: list
    trace: list


def _parse_json(text: str) -> dict:
    m = re.search(r"\{.*\}", text, re.S)
    try:
        return json.loads(m.group(0)) if m else {}
    except json.JSONDecodeError:
        return {}


def build_agent(
    llm: Callable[[str], str],
    search_fn: Callable[[str, Optional[str]], list],
    platform_fn: Optional[Callable[[], str]] = None,
):
    def log(state, msg):
        return state.get("trace", []) + [msg]

    def analyze(state: AgentState):
        prompt = (
            "Tu es l'assistant RH de la BFPME. Analyse la demande et réponds "
            'UNIQUEMENT en JSON : {"intent": "search_candidates|list_offers|chitchat", '
            '"search_query": "mots-clés du profil recherché", "offer_id": null}\n'
            f"Demande : {state['question']}"
        )
        data = _parse_json(llm(prompt))
        intent = data.get("intent", "search_candidates")
        if intent not in ("search_candidates", "list_offers", "chitchat"):
            intent = "search_candidates"
        return {
            "intent": intent,
            "search_query": data.get("search_query") or state["question"],
            "offer_id": state.get("offer_id") or data.get("offer_id"),
            "attempts": 0,
            "trace": log(state, f"analyze -> {intent}"),
        }

    def route_after_analyze(state: AgentState):
        if state["intent"] == "list_offers" and platform_fn:
            return "platform"
        if state["intent"] == "chitchat":
            return "generate"
        return "retrieve"

    def retrieve(state: AgentState):
        chunks = search_fn(state["search_query"], state.get("offer_id"))
        n = state.get("attempts", 0) + 1
        return {
            "chunks": chunks,
            "attempts": n,
            "trace": log(state, f"retrieve #{n} -> {len(chunks)} passages"),
        }

    def route_after_retrieve(state: AgentState):
        if len(state["chunks"]) < MIN_CHUNKS and state["attempts"] < MAX_ATTEMPTS:
            return "rewrite"
        return "generate"

    def rewrite(state: AgentState):
        new_q = llm(
            "Reformule cette recherche de candidats de façon plus large "
            "(synonymes, compétences voisines). Réponds par la requête seule.\n"
            f"Requête : {state['search_query']}"
        ).strip()
        return {"search_query": new_q, "trace": log(state, f"rewrite -> {new_q}")}

    def platform(state: AgentState):
        info = platform_fn() if platform_fn else ""
        return {"platform_info": info, "trace": log(state, "platform (API Spring Boot)")}

    def generate(state: AgentState):
        chunks = state.get("chunks", [])
        context = "\n\n".join(
            f"[{c['metadata'].get('source', '?')}] {c['text']}" for c in chunks
        ) or state.get("platform_info", "")
        prompt = (
            "Tu es l'assistant RH de la BFPME. Reponds en francais uniquement "
            "a partir des informations explicites du CONTEXTE.\n"
            "Regles obligatoires :\n"
            "1. Verifie chaque competence demandee separement pour chaque candidat.\n"
            "2. Ne deduis jamais une competence a partir du metier ou du titre.\n"
            "3. Si plusieurs competences sont demandees, ne confirme que les candidats "
            "dont le contexte mentionne toutes ces competences.\n"
            "4. Si une competence n'est pas mentionnee, indique qu'elle n'est pas confirmee.\n"
            "5. Cite la reference entre crochets pour chaque candidat presente.\n"
            "6. N'invente aucune information. Si les preuves sont insuffisantes, dis-le.\n\n"
            f"CONTEXTE :\n{context or '(vide)'}\n\nQUESTION : {state['question']}"
        )
        return {
            "answer": llm(prompt),
            "sources": sorted({c["metadata"].get("source", "?") for c in chunks}),
            "trace": log(state, "generate"),
        }

    g = StateGraph(AgentState)
    for name, fn in [("analyze", analyze), ("retrieve", retrieve), ("rewrite", rewrite),
                     ("platform", platform), ("generate", generate)]:
        g.add_node(name, fn)
    g.set_entry_point("analyze")
    g.add_conditional_edges("analyze", route_after_analyze,
                            {"retrieve": "retrieve", "platform": "platform", "generate": "generate"})
    g.add_conditional_edges("retrieve", route_after_retrieve,
                            {"rewrite": "rewrite", "generate": "generate"})
    g.add_edge("rewrite", "retrieve")
    g.add_edge("platform", "generate")
    g.add_edge("generate", END)
    return g.compile()