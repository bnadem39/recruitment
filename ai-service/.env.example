# Copie ce fichier en .env puis adapte les valeurs.

# --- Qdrant (base vectorielle) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=bfpme_recruitment

# --- Embeddings et découpage ---
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K=10

# --- Modèle de langage local (Ollama) ---
# Ollama doit tourner sur la machine hôte : ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1500
OLLAMA_TIMEOUT=180

# --- API Spring Boot (outil « offres » de l'agent) ---
SPRING_URL=http://host.docker.internal:8080

# --- ingest_applications.py (lancé hors Docker) ---
RAG_URL=http://localhost:8001

# --- Modèle de langage  (claude) ---
ANTHROPIC_API_KEY=Ta_cle
LLM_MODEL=claude-sonnet-5-5
SPRING_URL=http://host.docker.internal:8080
RAG_URL=http://localhost:8001
